{
  "name": "telakka",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^25.0.0",
    "pnpm": "^12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm gen:tauri && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "pnpm run build && tauri dev",
    "gen:tauri": "cd src-tauri && cargo run --bin gen_bindings",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml",
    "lint:fix": "eslint . --fix && cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty --allow-staged",
    "format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@primeuix/themes": "^3.0.1",
    "@primevue/forms": "^5.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "~2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.1",
    "primevue": "^5.0.1",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
